NODE_ENV=development
CLIENT_PORT=5173
SERVER_PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
# 生产环境默认仅信任本机 Nginx；代理不在本机时按实际拓扑显式配置。
TRUST_PROXY=
MONGODB_URI=mongodb://127.0.0.1:27017/personal_fullstack_blog
JWT_SECRET=replace-with-a-long-random-secret
# 可选。用于加密可再次查看的资源分享提取码，生产环境建议使用独立长随机值。
MEDIA_SHARE_ENCRYPTION_KEY=
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
# 媒体上传保护：并发请求数、单次文件总量、上传盘最小保留空间。
MEDIA_UPLOAD_MAX_CONCURRENT=2
MEDIA_UPLOAD_MAX_TOTAL_MB=1024
MEDIA_UPLOAD_DISK_RESERVE_MB=2048
# 可选。未配置或未安装 LibreOffice 时，文档型文章自动使用 DOCX 只读渲染。
OFFICE_CONVERTER_PATH=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
