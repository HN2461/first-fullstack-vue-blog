NODE_ENV=development
CLIENT_PORT=5173
SERVER_PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
CLIENT_ORIGINS=http://127.0.0.1:5173
TEA_DEMO_CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/personal_fullstack_blog
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
TEA_DEMO_JWT_SECRET=replace-with-a-long-random-secret-for-tea-demo
TEA_DEMO_JWT_EXPIRES_IN=2h
TEA_DEMO_AUTH_CHALLENGE_TTL_MS=120000
UPLOAD_DIR=uploads
# 可选。未配置或未安装 LibreOffice 时，文档型文章自动使用 DOCX 只读渲染。
OFFICE_CONVERTER_PATH=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
