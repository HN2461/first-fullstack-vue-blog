# 基础数据结构实验。逐段复制到 redis-cli，不要整文件直接用于生产。

# String 与 TTL
SET redis-learning:string:greeting "hello redis" EX 300
GET redis-learning:string:greeting
TTL redis-learning:string:greeting
SET redis-learning:counter:views 0 EX 300
INCR redis-learning:counter:views
INCRBY redis-learning:counter:views 10
GET redis-learning:counter:views

# Hash
HSET redis-learning:hash:user:1 name "Alice" status "active" loginCount 0
HGET redis-learning:hash:user:1 name
HMGET redis-learning:hash:user:1 name status
HINCRBY redis-learning:hash:user:1 loginCount 1
HGETALL redis-learning:hash:user:1
EXPIRE redis-learning:hash:user:1 300

# List：最近访问记录最多保留 5 条
RPUSH redis-learning:list:recent article:1 article:2 article:3
LPUSH redis-learning:list:recent article:4
LTRIM redis-learning:list:recent 0 4
LRANGE redis-learning:list:recent 0 -1
LLEN redis-learning:list:recent
EXPIRE redis-learning:list:recent 300

# Set：元素去重和成员判断
SADD redis-learning:set:article:1:liked-users user:1 user:2 user:3
SADD redis-learning:set:article:1:liked-users user:1
SISMEMBER redis-learning:set:article:1:liked-users user:2
SCARD redis-learning:set:article:1:liked-users
SSCAN redis-learning:set:article:1:liked-users 0 COUNT 10
EXPIRE redis-learning:set:article:1:liked-users 300

# Sorted Set：排行榜
ZADD redis-learning:zset:rank 100 article:1 80 article:2 120 article:3
ZINCRBY redis-learning:zset:rank 5 article:2
ZREVRANGE redis-learning:zset:rank 0 9 WITHSCORES
ZREVRANK redis-learning:zset:rank article:1
ZSCORE redis-learning:zset:rank article:1
EXPIRE redis-learning:zset:rank 300

# 类型与内存
TYPE redis-learning:zset:rank
MEMORY USAGE redis-learning:zset:rank
SCAN 0 MATCH redis-learning:* COUNT 50

# 只清理本实验明确创建的 Key
UNLINK redis-learning:string:greeting redis-learning:counter:views
UNLINK redis-learning:hash:user:1 redis-learning:list:recent
UNLINK redis-learning:set:article:1:liked-users redis-learning:zset:rank

