# 事务、Lua、限流和锁实验。逐段执行并观察返回值。

# MULTI/EXEC：命令连续执行，但不是 MySQL 式可回滚事务。
SET redis-learning:transaction:a 0 EX 300
SET redis-learning:transaction:b 0 EX 300
MULTI
INCR redis-learning:transaction:a
INCR redis-learning:transaction:b
EXEC
MGET redis-learning:transaction:a redis-learning:transaction:b

# Lua：原子执行 INCR，并在首次创建时设置 TTL。
EVAL "local current = redis.call('INCR', KEYS[1]); if current == 1 then redis.call('PEXPIRE', KEYS[1], ARGV[1]); end; if current > tonumber(ARGV[2]) then return {0, current}; end; return {1, current};" 1 redis-learning:rate-limit:lua:demo 60000 3
EVAL "local current = redis.call('INCR', KEYS[1]); if current == 1 then redis.call('PEXPIRE', KEYS[1], ARGV[1]); end; if current > tonumber(ARGV[2]) then return {0, current}; end; return {1, current};" 1 redis-learning:rate-limit:lua:demo 60000 3
EVAL "local current = redis.call('INCR', KEYS[1]); if current == 1 then redis.call('PEXPIRE', KEYS[1], ARGV[1]); end; if current > tonumber(ARGV[2]) then return {0, current}; end; return {1, current};" 1 redis-learning:rate-limit:lua:demo 60000 3
EVAL "local current = redis.call('INCR', KEYS[1]); if current == 1 then redis.call('PEXPIRE', KEYS[1], ARGV[1]); end; if current > tonumber(ARGV[2]) then return {0, current}; end; return {1, current};" 1 redis-learning:rate-limit:lua:demo 60000 3
PTTL redis-learning:rate-limit:lua:demo

# 原子库存扣减：这里只演示 Redis 原子性，不代表完整库存系统。
SET redis-learning:stock:product:1 5 EX 300
EVAL "local stock = tonumber(redis.call('GET', KEYS[1]) or '-1'); local amount = tonumber(ARGV[1]); if stock < amount then return 0; end; redis.call('DECRBY', KEYS[1], amount); return 1;" 1 redis-learning:stock:product:1 2
GET redis-learning:stock:product:1

# 获取锁，value 必须由客户端生成不可重复随机值。
SET redis-learning:lock:order:1 owner-demo-001 NX PX 30000
GET redis-learning:lock:order:1

# 错误 owner 无法释放。
EVAL "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1]); else return 0; end;" 1 redis-learning:lock:order:1 wrong-owner

# 正确 owner 才能释放。
EVAL "if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1]); else return 0; end;" 1 redis-learning:lock:order:1 owner-demo-001

# 清理本实验 Key
UNLINK redis-learning:transaction:a redis-learning:transaction:b
UNLINK redis-learning:rate-limit:lua:demo redis-learning:stock:product:1

